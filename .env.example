# Copy to .env when you need to override local defaults.
# Without MONGODB_URI, pnpm dev starts a persistent local replica set.
HOST=127.0.0.1
PORT=5173
APP_ORIGIN=http://127.0.0.1:5173
# MONGODB_URI=mongodb://127.0.0.1:27027/hotel_group3?replicaSet=hotel-local
# Set a unique secret of at least 32 characters for a hosted environment.
# SESSION_SECRET=
# Production requires MONGODB_URI, SESSION_SECRET and an HTTPS origin.
# Render supplies RENDER_EXTERNAL_URL automatically; set APP_ORIGIN only for a custom domain.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_FULL_NAME=Quản trị viên Nhóm 3
# BOOTSTRAP_ADMIN_PASSWORD=
# Set TRUST_PROXY=1 only behind a trusted, single reverse proxy.
TRUST_PROXY=0
HOTEL_TIMEZONE=Asia/Ho_Chi_Minh
DEPOSIT_PERCENT=30
